# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Chave secreta das sessões de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciais da Pluggy (Open Finance), em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Quantos meses de histórico importar do banco
MESES_HISTORICO=12
